{
  "openapi": "3.1.0",
  "info": {
    "title": "CredWise 360 local simulation API",
    "version": "1.0.0",
    "description": "Browser requests use the same-origin proxy. All responses containing financial amounts use integer INR paise unless the field describes a ratio or an index. Monetary operations and identity checks are simulated."
  },
  "servers": [{"url": "/api"}],
  "tags": [
    {"name": "System"},
    {"name": "Authentication"},
    {"name": "Financial profile"},
    {"name": "KYC"},
    {"name": "Settings"},
    {"name": "Administration"}
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "tags": ["System"],
        "summary": "Check database readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "The PostgreSQL schema is accessible.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/Health"}}
                }
              }
            }
          },
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register",
        "tags": ["Authentication"],
        "summary": "Create a synthetic customer account",
        "security": [{"browserAction": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegistrationInput"}}}
        },
        "responses": {
          "201": {
            "description": "The customer, financial profile and current session were created.",
            "headers": {"Set-Cookie": {"$ref": "#/components/headers/SessionCookie"}},
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/RegistrationResult"}}
                }
              }
            }
          },
          "403": {"$ref": "#/components/responses/Forbidden"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "415": {"$ref": "#/components/responses/UnsupportedMedia"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "429": {"$ref": "#/components/responses/TooManyRequests"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "tags": ["Authentication"],
        "summary": "Sign in to a customer or administrator workspace",
        "security": [{"browserAction": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginInput"}}}
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "headers": {"Set-Cookie": {"$ref": "#/components/headers/SessionCookie"}},
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/UserResult"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "415": {"$ref": "#/components/responses/UnsupportedMedia"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "429": {"$ref": "#/components/responses/TooManyRequests"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "tags": ["Authentication"],
        "summary": "Get the signed-in user",
        "security": [{"session": []}],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/UserResult"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": ["Authentication"],
        "summary": "End the current session",
        "security": [{"session": [], "browserAction": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {}}}}},
        "responses": {
          "200": {
            "description": "Successful response.",
            "headers": {"Set-Cookie": {"$ref": "#/components/headers/SessionCookie"}},
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["logged_out"],
                      "properties": {"logged_out": {"const": true}}
                    }
                  }
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "415": {"$ref": "#/components/responses/UnsupportedMedia"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/auth/recover": {
      "post": {
        "operationId": "recoverAccount",
        "tags": ["Authentication"],
        "summary": "Reset a password using a single-use recovery code",
        "description": "A successful reset revokes sessions and rotates the recovery code. Sign in with the new password.",
        "security": [{"browserAction": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecoveryInput"}}}
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/RecoveryResult"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "415": {"$ref": "#/components/responses/UnsupportedMedia"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "429": {"$ref": "#/components/responses/TooManyRequests"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/profile": {
      "get": {
        "operationId": "getFinancialProfile",
        "tags": ["Financial profile"],
        "summary": "Get the customer financial profile and calculated indicators",
        "security": [{"session": []}],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/ProfileResult"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      },
      "put": {
        "operationId": "updateFinancialProfile",
        "tags": ["Financial profile"],
        "summary": "Update the supplied financial profile fields",
        "description": "Omitted fields retain their values. Returns the full persisted profile and recalculated metrics.",
        "security": [{"session": [], "browserAction": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfileFields"}}}
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/ProfileResult"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "415": {"$ref": "#/components/responses/UnsupportedMedia"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/settings": {
      "get": {
        "operationId": "getSettings",
        "tags": ["Settings"],
        "summary": "Read account details, appearance and notification preferences",
        "security": [{"session": []}],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/SettingsResult"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      },
      "put": {
        "operationId": "updateSettings",
        "tags": ["Settings"],
        "summary": "Update account details or preferences",
        "description": "Members of a partial preferences object retain their old values when omitted. Changing the password revokes sessions and issues a new session to this browser. Self-deactivation requires the current password.",
        "security": [{"session": [], "browserAction": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SettingsInput"}}}
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "headers": {"Set-Cookie": {"$ref": "#/components/headers/SessionCookie"}},
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/SettingsResult"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "415": {"$ref": "#/components/responses/UnsupportedMedia"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/kyc": {
      "get": {
        "operationId": "getMyKyc",
        "tags": ["KYC"],
        "summary": "Read the customer’s simulated identity record",
        "security": [{"session": []}],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["kyc"],
                      "properties": {"kyc": {"oneOf": [{"$ref": "#/components/schemas/KycRecord"}, {"type": "null"}]}}
                    }
                  }
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      },
      "post": {
        "operationId": "submitKyc",
        "tags": ["KYC"],
        "summary": "Submit or resubmit synthetic identity evidence",
        "security": [{"session": [], "browserAction": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/KycInput"}}}
        },
        "responses": {
          "201": {
            "description": "The customer’s simulated KYC is pending administrator review.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/KycResult"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "415": {"$ref": "#/components/responses/UnsupportedMedia"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/kyc/document": {
      "get": {
        "operationId": "getMyKycDocument",
        "tags": ["KYC"],
        "summary": "Download the current customer’s synthetic document as base64",
        "security": [{"session": []}],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/DocumentContent"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/admin/kyc": {
      "get": {
        "operationId": "listKycReviews",
        "tags": ["Administration"],
        "summary": "List simulated identity records for administrator review",
        "security": [{"session": []}],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {"type": "string", "enum": ["pending", "verified", "rejected"]}
          },
          {"$ref": "#/components/parameters/Page"},
          {"$ref": "#/components/parameters/PageSize"}
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["items", "total", "page", "page_size"],
                      "properties": {
                        "items": {"type": "array", "items": {"$ref": "#/components/schemas/KycQueueItem"}},
                        "total": {"type": "integer", "minimum": 0},
                        "page": {"type": "integer", "minimum": 1},
                        "page_size": {"type": "integer", "minimum": 1, "maximum": 100}
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/admin/kyc/{user_id}": {
      "post": {
        "operationId": "reviewKyc",
        "tags": ["Administration"],
        "summary": "Verify or reject a pending synthetic identity submission",
        "security": [{"session": [], "browserAction": []}],
        "parameters": [{"$ref": "#/components/parameters/UserId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/KycDecision"}}}
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/KycResult"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "415": {"$ref": "#/components/responses/UnsupportedMedia"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/admin/kyc/{user_id}/document": {
      "get": {
        "operationId": "getKycReviewDocument",
        "tags": ["Administration"],
        "summary": "Download synthetic evidence for a KYC review",
        "security": [{"session": []}],
        "parameters": [{"$ref": "#/components/parameters/UserId"}],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/DocumentContent"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/admin/users": {
      "get": {
        "operationId": "listCustomers",
        "tags": ["Administration"],
        "summary": "Search the customer directory",
        "security": [{"session": []}],
        "parameters": [
          {"name": "q", "in": "query", "schema": {"type": "string"}},
          {"$ref": "#/components/parameters/Page"},
          {"$ref": "#/components/parameters/PageSize"}
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["items", "total", "page", "page_size"],
                      "properties": {
                        "items": {"type": "array", "items": {"$ref": "#/components/schemas/UserListItem"}},
                        "total": {"type": "integer", "minimum": 0},
                        "page": {"type": "integer", "minimum": 1},
                        "page_size": {"type": "integer", "minimum": 1, "maximum": 100}
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/admin/users/{id}": {
      "post": {
        "operationId": "setCustomerActivation",
        "tags": ["Administration"],
        "summary": "Activate or deactivate a customer account",
        "security": [{"session": [], "browserAction": []}],
        "parameters": [{"$ref": "#/components/parameters/Id"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"type": "object", "required": ["active"], "properties": {"active": {"type": "boolean"}}}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {"data": {"$ref": "#/components/schemas/UserResult"}}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "415": {"$ref": "#/components/responses/UnsupportedMedia"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cw",
        "description": "Opaque server-validated session cookie. Issued by registration and login."
      },
      "browserAction": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CredWise-Action",
        "description": "Set this header to 1 on every state-changing JSON request. When an Origin header is present it must match a configured web origin."
      }
    },
    "headers": {
      "SessionCookie": {"description": "Sets or expires the HttpOnly session cookie.", "schema": {"type": "string"}}
    },
    "parameters": {
      "UserId": {
        "name": "user_id",
        "in": "path",
        "required": true,
        "schema": {"type": "integer", "minimum": 1},
        "description": "Persisted customer identifier."
      },
      "Page": {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "default": 1}},
      "PageSize": {
        "name": "page_size",
        "in": "query",
        "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}
      },
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {"type": "integer", "minimum": 1},
        "description": "Persisted customer identifier."
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["service", "storage", "migrations", "initializations"],
        "properties": {
          "service": {"type": "string"},
          "storage": {"const": "PostgreSQL"},
          "migrations": {"type": "integer", "minimum": 0},
          "initializations": {"type": "integer", "minimum": 0}
        }
      },
      "Paise": {
        "type": "integer",
        "format": "int64",
        "minimum": 0,
        "maximum": 100000000000,
        "description": "Nonnegative INR amount in paise. 100 paise equal ₹1."
      },
      "User": {
        "type": "object",
        "required": ["id", "name", "email", "role", "active", "created_at"],
        "properties": {
          "id": {"type": "integer", "format": "int64", "minimum": 1},
          "name": {"type": "string"},
          "email": {"type": "string", "format": "email"},
          "role": {"type": "string", "enum": ["customer", "admin"]},
          "active": {"type": "boolean"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "UserResult": {"type": "object", "required": ["user"], "properties": {"user": {"$ref": "#/components/schemas/User"}}},
      "RegistrationInput": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 100},
          "email": {"type": "string", "format": "email"},
          "password": {
            "type": "string",
            "writeOnly": true,
            "format": "password",
            "description": "The new password must contain 12–128 UTF-8 bytes."
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {"type": "string", "format": "email"},
          "password": {"type": "string", "writeOnly": true, "format": "password"}
        }
      },
      "RecoveryInput": {
        "type": "object",
        "required": ["email", "recovery_code", "new_password"],
        "properties": {
          "email": {"type": "string", "format": "email"},
          "recovery_code": {"type": "string", "writeOnly": true},
          "new_password": {
            "type": "string",
            "writeOnly": true,
            "format": "password",
            "description": "The new password must contain 12–128 UTF-8 bytes."
          }
        }
      },
      "RegistrationResult": {
        "type": "object",
        "required": ["user", "recovery_code"],
        "properties": {
          "user": {"$ref": "#/components/schemas/User"},
          "recovery_code": {
            "type": "string",
            "description": "Single-use recovery credential displayed once. Retain privately."
          }
        }
      },
      "RecoveryResult": {
        "type": "object",
        "required": ["recovery_code"],
        "properties": {"recovery_code": {"type": "string", "description": "Replacement single-use recovery credential."}}
      },
      "ProfileFields": {
        "type": "object",
        "properties": {
          "employment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Fictional employment type. Maximum 80 UTF-8 bytes."
          },
          "salary": {"$ref": "#/components/schemas/Paise"},
          "business_income": {"$ref": "#/components/schemas/Paise"},
          "other_income": {"$ref": "#/components/schemas/Paise"},
          "essential": {"$ref": "#/components/schemas/Paise"},
          "discretionary": {"$ref": "#/components/schemas/Paise"},
          "savings": {"$ref": "#/components/schemas/Paise"},
          "existing_emi": {"$ref": "#/components/schemas/Paise"},
          "debt": {"$ref": "#/components/schemas/Paise"},
          "assets": {"$ref": "#/components/schemas/Paise"},
          "liabilities": {"$ref": "#/components/schemas/Paise"},
          "reserves": {"$ref": "#/components/schemas/Paise"},
          "stability_months": {"type": "integer", "minimum": 0, "maximum": 1200},
          "credit_months": {"type": "integer", "minimum": 0, "maximum": 1200},
          "utilization": {"type": "integer", "minimum": 0, "maximum": 100},
          "on_time": {"type": "integer", "minimum": 0, "maximum": 12000},
          "missed": {"type": "integer", "minimum": 0, "maximum": 12000},
          "income_regularity": {"type": "integer", "minimum": 0, "maximum": 100},
          "rent": {"type": "integer", "minimum": 0, "maximum": 100},
          "utilities": {"type": "integer", "minimum": 0, "maximum": 100},
          "consent": {"type": "boolean"},
          "goal": {
            "type": "string",
            "maxLength": 240,
            "description": "Synthetic savings goal. Maximum 240 UTF-8 bytes."
          },
          "goal_amount": {"$ref": "#/components/schemas/Paise"}
        },
        "additionalProperties": false
      },
      "FinancialProfile": {
        "allOf": [
          {"$ref": "#/components/schemas/ProfileFields"},
          {
            "type": "object",
            "required": [
              "employment",
              "salary",
              "business_income",
              "other_income",
              "essential",
              "discretionary",
              "savings",
              "existing_emi",
              "debt",
              "assets",
              "liabilities",
              "reserves",
              "stability_months",
              "credit_months",
              "utilization",
              "on_time",
              "missed",
              "income_regularity",
              "rent",
              "utilities",
              "consent",
              "goal",
              "goal_amount"
            ]
          }
        ]
      },
      "FinancialMetrics": {
        "type": "object",
        "required": [
          "income",
          "expenses",
          "disposable",
          "net_worth",
          "savings_rate",
          "dti",
          "emi_ratio",
          "coverage",
          "health"
        ],
        "properties": {
          "income": {
            "type": "integer",
            "format": "int64",
            "description": "Monthly salary plus business and other income, in paise."
          },
          "expenses": {
            "type": "integer",
            "format": "int64",
            "description": "Monthly essential and discretionary spending, in paise."
          },
          "disposable": {
            "type": "integer",
            "format": "int64",
            "description": "Income after expenses and existing EMI, before savings, in paise."
          },
          "net_worth": {
            "type": "integer",
            "format": "int64",
            "description": "Assets plus reserves less outstanding debt and other liabilities, in paise."
          },
          "savings_rate": {
            "type": ["number", "null"],
            "description": "Monthly savings as a percentage of income. Null when income is zero."
          },
          "dti": {
            "type": ["number", "null"],
            "description": "Outstanding debt as a percentage of annualized income. Null when income is zero."
          },
          "emi_ratio": {
            "type": ["number", "null"],
            "description": "Monthly EMI as a percentage of monthly income. Null when income is zero."
          },
          "coverage": {
            "type": ["number", "null"],
            "description": "Emergency reserves divided by monthly essential expenses plus existing EMI, in months. Null when this denominator is zero."
          },
          "health": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 100,
            "description": "Simulated financial health index. Null when income is zero."
          }
        }
      },
      "ProfileResult": {
        "type": "object",
        "required": ["profile", "metrics"],
        "properties": {
          "profile": {"$ref": "#/components/schemas/FinancialProfile"},
          "metrics": {"$ref": "#/components/schemas/FinancialMetrics"}
        }
      },
      "Preferences": {
        "type": "object",
        "required": ["theme", "language", "notifications"],
        "properties": {
          "theme": {"type": "string", "enum": ["system", "light", "dark"]},
          "language": {"type": "string", "enum": ["en", "hi"]},
          "notifications": {
            "type": "object",
            "required": ["applications", "payments", "learning", "distress"],
            "properties": {
              "applications": {"type": "boolean"},
              "payments": {"type": "boolean"},
              "learning": {"type": "boolean"},
              "distress": {"type": "boolean"}
            }
          }
        }
      },
      "PreferenceChanges": {
        "type": "object",
        "properties": {
          "theme": {"type": "string", "enum": ["system", "light", "dark"]},
          "language": {"type": "string", "enum": ["en", "hi"]},
          "notifications": {
            "type": "object",
            "properties": {
              "applications": {"type": "boolean"},
              "payments": {"type": "boolean"},
              "learning": {"type": "boolean"},
              "distress": {"type": "boolean"}
            }
          }
        }
      },
      "SettingsInput": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 100},
          "preferences": {"$ref": "#/components/schemas/PreferenceChanges"},
          "new_password": {
            "type": "string",
            "writeOnly": true,
            "format": "password",
            "description": "The new password must contain 12–128 UTF-8 bytes."
          },
          "current_password": {"type": "string", "writeOnly": true, "format": "password"},
          "active": {
            "type": "boolean",
            "description": "Submit false with current_password to deactivate your own account."
          }
        },
        "dependentRequired": {"new_password": ["current_password"]},
        "allOf": [
          {
            "if": {"required": ["active"], "properties": {"active": {"const": false}}},
            "then": {"required": ["current_password"]}
          }
        ]
      },
      "SettingsResult": {
        "type": "object",
        "required": ["user", "preferences"],
        "properties": {
          "user": {"$ref": "#/components/schemas/User"},
          "preferences": {"$ref": "#/components/schemas/Preferences"}
        }
      },
      "DocumentContent": {
        "type": "object",
        "required": ["name", "mime", "content_base64"],
        "properties": {
          "name": {"type": "string", "description": "Safe synthetic file name."},
          "mime": {"type": "string", "enum": ["text/plain", "application/pdf"]},
          "content_base64": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 349528,
            "description": "Base64 of a synthetic text file or PDF of at most 262144 decoded bytes. UTF-8 text starts with CREDWISE-SYNTHETIC. PDF starts with %PDF- and includes CREDWISE-SYNTHETIC."
          }
        }
      },
      "DocumentSummary": {
        "type": "object",
        "required": ["id", "name", "mime", "size", "sha256"],
        "properties": {
          "id": {"type": "integer", "format": "int64", "minimum": 1},
          "name": {"type": "string", "description": "Safe synthetic file name."},
          "mime": {"type": "string", "enum": ["text/plain", "application/pdf"]},
          "size": {"type": "integer", "minimum": 1, "maximum": 262144},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "KycInput": {
        "type": "object",
        "required": ["legal_name", "address", "employment", "pan", "document"],
        "properties": {
          "legal_name": {"type": "string", "minLength": 1},
          "address": {"type": "string", "minLength": 1},
          "employment": {"type": "string", "minLength": 1},
          "pan": {"type": "string", "pattern": "^DEMO[A-Z][0-9]{4}[A-Z]$", "examples": ["DEMOX1234Q"]},
          "document": {"$ref": "#/components/schemas/DocumentContent"}
        }
      },
      "KycRecord": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "legal_name",
          "address",
          "employment",
          "pan",
          "status",
          "reason",
          "created_at",
          "updated_at",
          "document"
        ],
        "properties": {
          "id": {"type": "integer", "format": "int64", "minimum": 1},
          "user_id": {"type": "integer", "format": "int64", "minimum": 1},
          "legal_name": {"type": "string"},
          "address": {"type": "string"},
          "employment": {"type": "string"},
          "pan": {"type": "string"},
          "status": {"type": "string", "enum": ["pending", "verified", "rejected"]},
          "reason": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"},
          "document": {"$ref": "#/components/schemas/DocumentSummary"}
        }
      },
      "KycResult": {
        "type": "object",
        "required": ["kyc"],
        "properties": {"kyc": {"$ref": "#/components/schemas/KycRecord"}}
      },
      "KycDecision": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"type": "string", "enum": ["verified", "rejected"]},
          "reason": {"type": "string", "description": "A written reason is required for rejection."}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "rejected"}}},
            "then": {"required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1}}}
          }
        ]
      },
      "KycQueueItem": {
        "allOf": [
          {"$ref": "#/components/schemas/KycRecord"},
          {
            "type": "object",
            "required": ["name", "email"],
            "properties": {"name": {"type": "string"}, "email": {"type": "string", "format": "email"}}
          }
        ]
      },
      "UserListItem": {
        "allOf": [
          {"$ref": "#/components/schemas/User"},
          {
            "type": "object",
            "required": ["kyc_status"],
            "properties": {"kyc_status": {"type": "string", "enum": ["not_started", "pending", "verified", "rejected"]}}
          }
        ]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication or account credentials are missing, invalid or expired.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}
      },
      "Forbidden": {
        "description": "The caller lacks permission or the write-origin verification failed.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}
      },
      "NotFound": {
        "description": "The requested record does not exist.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}
      },
      "Conflict": {
        "description": "The request conflicts with an existing record or its current state.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}
      },
      "UnsupportedMedia": {
        "description": "State-changing endpoints require an application/json content type.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}
      },
      "InvalidInput": {
        "description": "The request is malformed or one of its values fails validation.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}
      },
      "TooManyRequests": {
        "description": "The configured request limit has been reached.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}
      },
      "ServiceUnavailable": {
        "description": "The database or native service is unavailable.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}
      }
    }
  }
}
