# Docker Compose (copy to .env and set a local password)
POSTGRES_DB=credwise
POSTGRES_USER=credwise
POSTGRES_PASSWORD=replace_with_a_local_random_password
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_MODE=1

# Hosted deployment (Render + Neon). Set these in the Render dashboard, never in a committed file.
# See docs/deployment.md.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#   DATABASE_SSLMODE=require          # optional if the URL already has sslmode
#   DATABASE_CONNECT_TIMEOUT=15       # seconds, optional
#   WEB_ORIGINS=https://your-service.onrender.com   # optional on Render (derived from RENDER_EXTERNAL_URL)
#   COOKIE_SECURE=1
#   TRUST_PROXY=1
#   SEED_DEMO=1
